# ==========================================
# ToolBot Environment Configuration Template
# Copy this file to .env and fill in your keys
# ==========================================

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# External Tools
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# MCP Servers (Model Context Protocol)
MCP_ARITH_SCRIPT_PATH=
MCP_EXPENSE_URL=https://splendid-gold-dingo.fastmcp.app/mcp
MCP_CONTEXT7_URL=https://mcp.context7.com/mcp
MCP_DEEPWIKI_URL=https://mcp.deepwiki.com/mcp

# Storage & Persistence
DATABASE_PATH=chatbot.db
INDEXES_DIR=data/indexes

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
